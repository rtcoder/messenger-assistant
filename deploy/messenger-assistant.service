[Unit]
Description=Messenger Assistant
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=messenger-assistant
Group=messenger-assistant
WorkingDirectory=/srv/messenger-assistant
Environment=NODE_ENV=production
Environment=BOT_CONFIG_DIR=/etc/messenger-assistant
Environment=BOT_DATA_DIR=/var/lib/messenger-assistant
ExecStart=/usr/bin/node /srv/messenger-assistant/main.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/messenger-assistant
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=100%
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
