# Add your TLS certificate directives; replace the example paths and hostname.
server {
    listen 443 ssl;
    server_name bot.example.com;
    root /srv/messenger-assistant/public;
    index index.php;
    server_tokens off;
    client_max_body_size 1k;

    location / {
        try_files /__no_static_files__ /index.php$is_args$args;
    }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param BOT_LINKS_DB /var/lib/messenger-assistant/links.sqlite;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { return 404; }
}
